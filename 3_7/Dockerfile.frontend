FROM node:16-alpine

WORKDIR /myapp

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install && \
    npm run build && \
    npm install -g serve && \
    rm -rf /myapp/src /myapp/node_modules && \
    adduser -D appuser && chown -R appuser /myapp

USER appuser

EXPOSE 5001

CMD ["serve", "-s", "-l", "5001", "build"]
