# ==============================================================================
# Recommended .dockerignore for exercise-dockerignore (DevOps with Docker 3.10)
# ==============================================================================

# 1. Version Control & Git History (Critical Privacy & Size)
.git
.gitignore
.github

# 2. Secrets & Environment Variables (Critical Security)
.env
.env.*
!.env.example

# 3. Local Data Backups & Dumps (Critical Security & Size)
backup/
*.sql
*.dump
*.tar.gz

# 4. Dependency directories & Caches (Size & Architecture Compatibility)
node_modules/
.npm/
.yarn/
.pnpm-store/

# 5. Documentation & Development Notes (Size & Information Disclosure)
documentation/
README.md
*.md

# 6. Tests & Test Configurations
tests/
__tests__/
*.test.*
*.spec.*
.oxlintrc.json

# 7. Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 8. Editor & Operating System Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 9. Docker configuration files
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
